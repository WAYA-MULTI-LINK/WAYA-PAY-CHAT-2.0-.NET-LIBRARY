<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WayaPay</RootNamespace>
    <AssemblyName>WayaPay</AssemblyName>
    <PackageId>WayaPay</PackageId>
    <Version>2.0.0</Version>
    <Authors>WayaPay</Authors>
    <Description>.NET client for the WayaPay Merchant API v2: collect, payout, accounts, identity.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>wayapay;wayaquick;payments;payout;collect;bvn;nigeria;fintech</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Sample code is documentation, not part of the shipped library. -->
  <ItemGroup>
    <Compile Remove="examples/**/*.cs" />
  </ItemGroup>

</Project>
